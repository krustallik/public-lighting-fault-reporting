# Development Docker Compose template only.
# Copy this file to the repository-root .env for the general dev stack.
# The isolated local UAT launcher does not load this file; see LOCAL_UAT_GUIDE.md.
# Never use these development defaults in production or commit a populated .env.

# PostgreSQL
# For a backend process run directly on Windows against the Compose-published DB.
# The Compose backend container ignores this value and uses its private db service.
DB_HOST=127.0.0.1
# Host-published database port; direct host backend must use the same port.
DB_PORT=5432
DB_NAME=lighting_faults_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Backend
NODE_ENV=development
BACKEND_PORT=5000
CORS_ORIGIN=http://localhost:5173
LOCAL_TEST_SUBMIT_ENABLED=false
LOCAL_TEST_MAX_FILE_BYTES=10485760
LOCAL_TEST_MAX_FILES=3
LOCAL_TEST_MAX_TOTAL_UPLOAD_BYTES=20971520
# Development-only fallback when empty. Before enabling OTP or production,
# supply a random canonical base64url secret encoding at least 32 bytes.
JWT_SECRET=
# Email verification is disabled by default. Resend credentials are optional
# while false. For LIVE_PROVIDER_UAT, use the separate protected files described
# in LOCAL_UAT_GUIDE.md instead of dotenv inheritance.
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Development-only optional password for the manually invoked seed:dev setup.
# No default admin password is provided; never pass this setting to production.
ADMIN_INITIAL_PASSWORD=

# Citizen address assistance is off in this safe template. The owner-specific
# development .env may enable it; LIVE_PROVIDER_UAT reads a protected private
# key file and enables report-time suggestions only after its explicit gate.
GEOAPIFY_ENABLED=false
GEOAPIFY_BASE_URL=https://api-eu.geoapify.com
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_MS=3000
GEOAPIFY_MAX_ACTIVE=1
GEOAPIFY_MAX_PENDING=1
GEOAPIFY_START_INTERVAL_MS=250
GEOAPIFY_QUEUE_EXPIRY_MS=4000
GEOAPIFY_DAILY_BUDGET=2700
ADDRESS_IP_BUCKET_BURST=10
ADDRESS_IP_REFILL_PER_MINUTE=30
ADDRESS_IP_MAX_KEYS=8192
ADDRESS_IP_IDLE_TTL_MS=120000
# Empty means Express trusts no proxy and ignores X-Forwarded-For.
TRUST_PROXY_CIDRS=

# Frontend host port mappings for the loopback-only development stack.
FRONTEND_PORT=5173
ADMIN_FRONTEND_PORT=5174
CHOKIDAR_USEPOLLING=false
# Compose fixes the public/admin API path to same-origin /api and proxies it to backend.
VITE_MAP_TILE_PROVIDER=disabled
VITE_CARTO_TILES_APPROVED=false
VITE_CARTO_PUBLIC_KEY=
# Device recenter is opt-in in the template; UAT explicitly configures its own value.
VITE_ALLOW_DEVICE_MAP_RECENTER=false
# Non-default admin UI path (login is still required).
VITE_ADMIN_BASE_PATH=/panel-svietidla

# AUSEMIO / DPMK integration
AUSEMIO_BASE_URL=https://kosice.ausemio.io/public_issues
AUSEMIO_API_KEY=
AUSEMIO_TEST_MODE=true
AUSEMIO_LOCALE=sk

# Reverse geocoding (OpenStreetMap Nominatim)
# Set to true to geocode light points automatically on startup and on create/update.
# Manual script always works: docker exec lighting-backend npm run geocode:points
NOMINATIM_AUTO_GEOCODE=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="PublicLightingFaultReporting/1.0 (thesis; contact: admin@example.com)"
NOMINATIM_ACCEPT_LANGUAGE=sk
NOMINATIM_MIN_INTERVAL_MS=1100
