# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=lighting_faults_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Backend
NODE_ENV=development
BACKEND_PORT=5000
CORS_ORIGIN=http://localhost:5173
LOCAL_TEST_SUBMIT_ENABLED=false
LOCAL_TEST_MAX_FILE_BYTES=10485760
LOCAL_TEST_MAX_FILES=3
LOCAL_TEST_MAX_TOTAL_UPLOAD_BYTES=20971520
JWT_SECRET=change-me-in-production-use-long-random-string
# Development-only optional password for the manually invoked seed:dev setup.
# No default admin password is provided; never pass this setting to production.
ADMIN_INITIAL_PASSWORD=

# Citizen address assistance — disabled until provider/privacy/owner activation gates close.
GEOAPIFY_ENABLED=false
GEOAPIFY_BASE_URL=https://api-eu.geoapify.com
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_MS=3000
GEOAPIFY_MAX_ACTIVE=1
GEOAPIFY_MAX_PENDING=1
GEOAPIFY_START_INTERVAL_MS=250
GEOAPIFY_QUEUE_EXPIRY_MS=4000
GEOAPIFY_DAILY_BUDGET=2700
ADDRESS_IP_BUCKET_BURST=10
ADDRESS_IP_REFILL_PER_MINUTE=30
ADDRESS_IP_MAX_KEYS=8192
ADDRESS_IP_IDLE_TTL_MS=120000
# Empty means Express trusts no proxy and ignores X-Forwarded-For.
TRUST_PROXY_CIDRS=

# Frontend (used by Vite — must be reachable from the browser)
FRONTEND_PORT=5173
# Vite development servers proxy same-origin /api requests to the backend.
VITE_API_URL=/api
VITE_MAP_TILE_PROVIDER=disabled
VITE_CARTO_TILES_APPROVED=false
VITE_CARTO_PUBLIC_KEY=
VITE_ALLOW_DEVICE_MAP_RECENTER=false
# Non-default admin UI path (security through obscurity; login still required)
VITE_ADMIN_BASE_PATH=/panel-svietidla

# AUSEMIO / DPMK integration
AUSEMIO_BASE_URL=https://kosice.ausemio.io/public_issues
AUSEMIO_API_KEY=
AUSEMIO_TEST_MODE=true
AUSEMIO_LOCALE=sk

# Reverse geocoding (OpenStreetMap Nominatim)
# Set to true to geocode light points automatically on startup and on create/update.
# Manual script always works: docker exec lighting-backend npm run geocode:points
NOMINATIM_AUTO_GEOCODE=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="PublicLightingFaultReporting/1.0 (thesis; contact: admin@example.com)"
NOMINATIM_ACCEPT_LANGUAGE=sk
NOMINATIM_MIN_INTERVAL_MS=1100
