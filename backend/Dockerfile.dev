FROM node:24.22.2-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY tsconfig.json ./
# Seed image with source so the container starts before Compose Watch syncs.
COPY src ./src

EXPOSE 5000

CMD ["npm", "run", "dev"]
