FROM node:24.22.2-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS build
WORKDIR /app
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/ ./
RUN npm run build

FROM node:24.22.2-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS runtime
ARG APP_BUILD_SHA=unknown
ARG MIGRATION_VERSION=0007
LABEL org.opencontainers.image.revision="$APP_BUILD_SHA" \
      org.opencontainers.image.version="$APP_BUILD_SHA" \
      org.public-lighting.migration-version="$MIGRATION_VERSION"
WORKDIR /app
ENV NODE_ENV=production
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build --chown=node:node /app/dist ./dist
USER node:node
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "require('node:http').get({hostname:'127.0.0.1',port:5000,path:'/api/health',headers:{host:'mapa-svietidiel.sk'}},(r)=>{r.resume();process.exitCode=r.statusCode>=200&&r.statusCode<300?0:1}).on('error',()=>process.exit(1))"
CMD ["node", "dist/index.js"]
