{
  "name": "public-lighting-backend",
  "version": "0.1.0",
  "description": "Backend API for public lighting fault reporting",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "e2e:test-server": "tsx tests/e2e-support/server.ts",
    "geocode:points": "tsx src/scripts/geocodeLightPoints.ts",
    "generate:service-area": "tsx src/scripts/generateKosiceServiceArea.ts",
    "check:service-area": "tsx src/scripts/generateKosiceServiceArea.ts --check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "jsts": "2.12.1",
    "multer": "^2.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
