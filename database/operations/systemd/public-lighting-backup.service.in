# REFERENCE TEMPLATE ONLY. Not installed, enabled, or production-approved.
[Unit]
Description=Public lighting encrypted database backup (gated)
ConditionPathExists=/etc/public-lighting/operations/PRODUCTION_BACKUP_ADAPTER_APPROVED
After=network-online.target postgresql.service
StartLimitIntervalSec=1h
StartLimitBurst=2

[Service]
Type=oneshot
User=lighting-operations
Group=lighting-operations
Environment=NODE_ENV=production
Environment=DATABASE_OPERATIONS_MODE=production
ExecStart=@BACKEND_INSTALL_ROOT@/dist/scripts/databaseOperations.js backup-scheduled
Restart=on-failure
RestartSec=15min
RestartPreventExitStatus=10 12 78
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/public-lighting/operations

# Deliberately no [Install] section; activation requires a reviewed host package and unit copy.
