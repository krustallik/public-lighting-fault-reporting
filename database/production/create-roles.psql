\set ON_ERROR_STOP on

-- Run as the DBA on a trusted interactive terminal. \password prompts without
-- placing the secret in shell history, command arguments, or server-side SQL logs.
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'lighting_migrator') THEN
    CREATE ROLE lighting_migrator LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'lighting_runtime') THEN
    CREATE ROLE lighting_runtime LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'lighting_bootstrap') THEN
    CREATE ROLE lighting_bootstrap LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
  END IF;
END
$$;

\password lighting_migrator
\password lighting_runtime
\password lighting_bootstrap

DO $$
DECLARE
  database_name TEXT := current_database();
BEGIN
  EXECUTE format('GRANT CONNECT ON DATABASE %I TO lighting_migrator, lighting_runtime, lighting_bootstrap', database_name);
END
$$;

GRANT USAGE, CREATE ON SCHEMA public TO lighting_migrator;
GRANT USAGE ON SCHEMA public TO lighting_runtime, lighting_bootstrap;
CREATE EXTENSION IF NOT EXISTS pgcrypto;
CREATE EXTENSION IF NOT EXISTS postgis;
