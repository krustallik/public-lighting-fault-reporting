FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de AS runtime
LABEL org.public-lighting.application="edge" \
      org.public-lighting.proxy-config="nginx-production-v1"
RUN rm -f /etc/nginx/conf.d/default.conf \
  && mkdir -p /etc/nginx/snippets /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp \
  && chown -R 101:101 /var/cache/nginx
COPY frontend/nginx/nginx.conf /etc/nginx/nginx.conf
COPY frontend/nginx/snippets/api-proxy.conf /etc/nginx/snippets/api-proxy.conf
COPY frontend/nginx/snippets/security-headers.conf /etc/nginx/snippets/security-headers.conf
USER 101:101
EXPOSE 8080 8443
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
