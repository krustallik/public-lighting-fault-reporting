# syntax=docker/dockerfile:1.7
FROM node:20.20.0-bookworm-slim@sha256:d8a35d586fad3af7abb6fdb9ba972388395405f4d462da9e4a4ddcde67b5e0fb AS build-base
WORKDIR /workspace/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./

FROM build-base AS public-build
ARG VITE_CARTO_PUBLIC_KEY
ARG PUBLIC_BUILD_ID=unknown
ARG VITE_LIVE_PROVIDER_UAT=false
ARG VITE_ALLOW_DEVICE_MAP_RECENTER=false
ARG VITE_REPORT_SUBMISSION_MODE=disabled
RUN --mount=type=secret,id=carto_public_key,required=false \
  set -eu; \
  carto_key="${VITE_CARTO_PUBLIC_KEY:-}"; \
  if [ -s /run/secrets/carto_public_key ]; then \
    carto_key="$(tr -d '\r\n' < /run/secrets/carto_public_key)"; \
  fi; \
  test -n "$carto_key"; \
  if [ "$VITE_LIVE_PROVIDER_UAT" = "true" ]; then \
    LOCAL_UAT_MODE=true LOCAL_UAT_CONTAINER_MODE=true VITE_LOCAL_UAT_MODE=true \
      VITE_API_URL=/api VITE_MAP_TILE_PROVIDER=carto VITE_CARTO_TILES_APPROVED=true \
      VITE_CARTO_PUBLIC_KEY="$carto_key" VITE_LIVE_PROVIDER_UAT=true \
      VITE_REPORT_SUBMISSION_MODE="$VITE_REPORT_SUBMISSION_MODE" \
      VITE_ALLOW_DEVICE_MAP_RECENTER="$VITE_ALLOW_DEVICE_MAP_RECENTER" \
      npx vite build --config apps/public/vite.config.ts --mode local-uat; \
  else \
    VITE_API_URL=/api VITE_MAP_TILE_PROVIDER=carto VITE_CARTO_TILES_APPROVED=true \
      VITE_CARTO_PUBLIC_KEY="$carto_key" VITE_REPORT_SUBMISSION_MODE="$VITE_REPORT_SUBMISSION_MODE" \
      VITE_ALLOW_DEVICE_MAP_RECENTER="$VITE_ALLOW_DEVICE_MAP_RECENTER" npm run build:public; \
  fi; \
  printf '{"application":"public","revision":"%s"}\n' "$PUBLIC_BUILD_ID" > dist/public/build-info.json

FROM build-base AS admin-build
ARG ADMIN_BUILD_ID=unknown
ARG ADMIN_BUILD_MODE=production
ARG VITE_ADMIN_BASE_PATH=/
ARG VITE_ADMIN_ASSET_BASE_PATH=/
RUN if [ "$ADMIN_BUILD_MODE" = "local-uat" ]; then \
      LOCAL_UAT_MODE=true LOCAL_UAT_CONTAINER_MODE=true \
        VITE_API_URL=/api VITE_MAP_TILE_PROVIDER=disabled VITE_CARTO_TILES_APPROVED=false \
        VITE_ADMIN_BASE_PATH="$VITE_ADMIN_BASE_PATH" \
        VITE_ADMIN_ASSET_BASE_PATH="$VITE_ADMIN_ASSET_BASE_PATH" \
        npx vite build --config apps/admin/vite.config.ts --mode local-uat; \
    else \
      VITE_API_URL=/api VITE_MAP_TILE_PROVIDER=disabled VITE_CARTO_TILES_APPROVED=false \
        VITE_ADMIN_BASE_PATH="$VITE_ADMIN_BASE_PATH" \
        VITE_ADMIN_ASSET_BASE_PATH="$VITE_ADMIN_ASSET_BASE_PATH" npm run build:admin; \
    fi \
  && printf '{"application":"admin","revision":"%s"}\n' "$ADMIN_BUILD_ID" > dist/admin/build-info.json

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de AS public-runtime
ARG PUBLIC_BUILD_ID=unknown
LABEL org.opencontainers.image.revision="$PUBLIC_BUILD_ID" \
      org.public-lighting.application="public" \
      org.public-lighting.public-build="$PUBLIC_BUILD_ID"
RUN rm -f /etc/nginx/conf.d/default.conf \
  && mkdir -p /var/cache/nginx/client_temp /usr/share/nginx/html \
  && chown -R 101:101 /var/cache/nginx /usr/share/nginx/html
COPY frontend/nginx/static.conf /etc/nginx/nginx.conf
COPY --from=public-build --chown=101:101 /workspace/frontend/dist/public/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8080
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de AS admin-runtime
ARG ADMIN_BUILD_ID=unknown
LABEL org.opencontainers.image.revision="$ADMIN_BUILD_ID" \
      org.public-lighting.application="admin" \
      org.public-lighting.admin-build="$ADMIN_BUILD_ID"
RUN rm -f /etc/nginx/conf.d/default.conf \
  && mkdir -p /var/cache/nginx/client_temp /usr/share/nginx/html \
  && chown -R 101:101 /var/cache/nginx /usr/share/nginx/html
COPY frontend/nginx/static.conf /etc/nginx/nginx.conf
COPY --from=admin-build --chown=101:101 /workspace/frontend/dist/admin/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8080
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
