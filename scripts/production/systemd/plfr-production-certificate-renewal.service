[Unit]
Description=Renew mapa-svietidiel.sk TLS certificate using Websupport DNS-01
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=WEBSUPPORT_API_KEY_FILE=/etc/plfr-production/secrets/websupport-api-key
Environment=WEBSUPPORT_SECRET_FILE=/etc/plfr-production/secrets/websupport-secret
Environment=WEBSUPPORT_HTTP_TIMEOUT=10
Environment=WEBSUPPORT_POLLING_INTERVAL=5
Environment=WEBSUPPORT_PROPAGATION_TIMEOUT=180
Environment=WEBSUPPORT_TTL=600
EnvironmentFile=/etc/plfr-production/acme.env
ExecStart=/opt/plfr-production/control/renew-production-certificate.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/plfr-acme /etc/plfr-production/tls /run/lock
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=20min
StandardOutput=journal
StandardError=journal
